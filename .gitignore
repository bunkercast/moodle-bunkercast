# amd/build/ IS committed, deliberately.
#
# The plugin directory is what gets installed, and a Moodle administrator has no
# Node or grunt — if the built AMD is absent the player JS never loads and the
# video silently never appears. Published Moodle plugins ship their build output
# for this reason.
#
# Rebuild after any amd/src change:
#   npx grunt amd --root=filter/bunkercast
#   npx grunt amd --root=lib/editor/tiny/plugins/bunkercast
.DS_Store
